{
  "name": "systempulse",
  "version": "1.0.0",
  "description": "SystemPulse - Smart Desktop System Monitor",
  "main": "electron/main.js",
  "author": "Shanmukha",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "dev:ci": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --no-sandbox\"",
    "test": "node --test tests/*.test.js",
    "lint": "npx --yes eslint@9.39.1 electron/*.js src/utils/*.js tests/*.js eslint.config.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "package:mac": "npm run build && npx --yes sharp-cli@5.1.0 -i build/icon.svg -o 'build/{name}.png' resize 1024 1024 && test -s build/icon.png && npx --yes electron-builder@26.0.12 --mac dmg --universal",
    "test:packaged": "node scripts/verify-packaged-app.mjs"
  },
  "productName": "SystemPulse",
  "build": {
    "appId": "com.shanmukha.systempulse",
    "productName": "SystemPulse",
    "artifactName": "SystemPulse-${version}-universal.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "SystemPulse ${version}"
    }
  }
}
